APP_NAME=celuma
ENV=dev
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/celumadb
JWT_SECRET=changeme
JWT_EXPIRES_MIN=480

AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=xxxxxxxx
AWS_REGION=mx-central-1
S3_BUCKET_NAME=your-bucket

MEDIA_PUBLIC_BASE_URL=https://dxxxxxxxxxxxxx.cloudfront.net

# MEDIA_PRESIGNED_EXPIRE_SECONDS=3600
# S3_ENDPOINT_URL=http://localhost:4566

# Comma-separated list of allowed frontend origins for CORS. Must never
# contain a bare "*" (breaks credentialed requests — see app/main.py).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Céluma 1.3 Fase 2, Bloque E: official PDF generation (headless Chromium via
# Playwright, running inside the api container). PDF_GENERATOR_BASE_URL has no
# default — it must point at the frontend origin the backend can actually
# reach (from inside Docker, the host's `npm run dev` is typically
# http://host.docker.internal:5173; a built/served frontend uses its own
# origin). See docs/celuma-1.3/phase-2-block-e/pdf-generation-contract.md.
PDF_GENERATOR_BASE_URL=http://host.docker.internal:5173
# PDF_GENERATION_TIMEOUT_SECONDS=30
# PDF_RENDER_TOKEN_EXPIRES_SECONDS=90
# PDF_RENDER_TOKEN_SECRET=changeme-distinct-from-jwt-secret
# PDF_MAX_SIZE_BYTES=26214400
# PDF_MAX_PAGE_COUNT=100