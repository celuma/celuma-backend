APP_NAME=celuma
ENV=dev
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/celumadb
JWT_SECRET=changeme
JWT_EXPIRES_MIN=480

AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=xxxxxxxx
AWS_REGION=mx-central-1
S3_BUCKET_NAME=your-bucket

MEDIA_PUBLIC_BASE_URL=https://dxxxxxxxxxxxxx.cloudfront.net

# MEDIA_PRESIGNED_EXPIRE_SECONDS=3600
# S3_ENDPOINT_URL=http://localhost:4566

# Comma-separated list of allowed frontend origins for CORS. Must never
# contain a bare "*" (breaks credentialed requests — see app/main.py).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Céluma 1.3 Fase 2, Bloque E: official PDF generation (headless Chromium via
# Playwright, running inside the api container). PDF_GENERATOR_BASE_URL has no
# default — it must point at the frontend origin the backend can actually
# reach (from inside Docker, the host's `npm run dev` is typically
# http://host.docker.internal:5173; a built/served frontend uses its own
# origin). See docs/celuma-1.3/phase-2-block-e/pdf-generation-contract.md.
PDF_GENERATOR_BASE_URL=http://host.docker.internal:5173
# PDF_GENERATION_TIMEOUT_SECONDS=30
# PDF_RENDER_TOKEN_EXPIRES_SECONDS=90
# PDF_RENDER_TOKEN_SECRET=changeme-distinct-from-jwt-secret
# PDF_MAX_SIZE_BYTES=26214400
# PDF_MAX_PAGE_COUNT=100
# Céluma 1.3 Fase 3, Bloque E: entrega de correo para notificaciones.
# Contrato completo: docs/celuma-1.3/phase-3-block-e/configuration-reference.md
#
# EMAIL_ENABLED es el interruptor maestro del worker de entrega y su valor por
# defecto es `false`. Mientras esté en false no se inicia ningún poller, no se
# contacta a ningún proveedor y las filas PENDING simplemente se acumulan. Se
# activa de forma deliberada por entorno, una vez que exista la identidad SES
# verificada y el permiso IAM `ses:SendEmail`.
# EMAIL_ENABLED=false

# `ses` (producción) o `fake` (desarrollo local sin AWS: registra los correos
# en memoria y no envía nada).
# EMAIL_PROVIDER=ses

# Dirección remitente. NO tiene valor por defecto a propósito: antes de este
# bloque el código caía silenciosamente en `noreply@celuma.com`, que no es una
# identidad verificada en SES, así que todos los envíos eran rechazados. Debe
# ser una identidad verificada del dominio remitente.
# EMAIL_SENDER=notificaciones@celuma.mx

# Nombre visible del remitente. Se interpola en la cabecera `From`, por lo que
# no admite saltos de línea, comillas ni <>.
# EMAIL_SENDER_NAME=Céluma

# Región de SES. Céluma corre en `mx-central-1`, donde SES no está disponible,
# así que no puede reutilizar AWS_REGION como hace S3. Si no se define, cae en
# AWS_REGION.
# EMAIL_SES_REGION=us-east-1

# Origen del frontend. Se usa como la única llamada a la acción de los correos
# de notificación ("Inicia sesión en Céluma") y para los enlaces de invitación
# y restablecimiento de contraseña. Debe ser un origen http(s) absoluto.
# En producción celuma-infra ya lo define en la task definition.
# FRONTEND_URL=http://localhost:5173

# Intervalo del poller de entrega, en segundos (1–3600). Block A recomienda
# 10–15 s.
# DELIVERY_POLL_INTERVAL_SECONDS=10
